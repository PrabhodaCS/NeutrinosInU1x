\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Schematic representation of the Clockwork chain. The nodes $0 \dots  N$ represent sites in theory space. The dashed blue lines represent the mass mixing. The vertical lines correspond to the site-local mass $\mu $, while the diagonal lines represent the nearest-neighbour mixing $q\mu $. The overlap of the zero-mode with the boundary fields generates the suppression $y_{22} \sim q^N$.}}{21}{figure.8}\protected@file@percent }
\newlabel{fig:clockwork_diagram}{{8}{21}{Schematic representation of the Clockwork chain. The nodes $0 \dots N$ represent sites in theory space. The dashed blue lines represent the mass mixing. The vertical lines correspond to the site-local mass $\mu $, while the diagonal lines represent the nearest-neighbour mixing $q\mu $. The overlap of the zero-mode with the boundary fields generates the suppression $y_{22} \sim q^N$}{figure.8}{}}
\newlabel{fig:clockwork_diagram@cref}{{[figure][8][2147483647]8}{[1][20][]21}}
