\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The ``spaghetti'' Feynman diagram leading to an approximate effective field theory FN operator $A\left (\frac  {\langle \theta \rangle }{\Lambda _{\text  {FN}}} \right )^{|X_i-X_j|} \overline  {\psi _j} H \psi _i$. Each $\times $ represents a mass insertion of a different heavy beyond-the-SM fermionic field $\psi _{\text  {FN}_i}$ whose charges are integers, differing by one unit in each case from left to right. $\psi _{\text  {FN}_i}$ are in vector-like representations of the SM gauge group and have mass scale of order $\Lambda _{\text  {FN}}$. $A$ is an effective coupling given by the product of all couplings in the diagram and another factor taking into account any mass factors between the $\psi _{\text  {FN}_i}$ fields.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:spag}{{1}{3}{The ``spaghetti'' Feynman diagram leading to an approximate effective field theory FN operator $A\left (\frac {\langle \theta \rangle }{\Lambda _{\text {FN}}} \right )^{|X_i-X_j|} \overline {\psi _j} H \psi _i$. Each $\times $ represents a mass insertion of a different heavy beyond-the-SM fermionic field $\psi _{\text {FN}_i}$ whose charges are integers, differing by one unit in each case from left to right. $\psi _{\text {FN}_i}$ are in vector-like representations of the SM gauge group and have mass scale of order $\Lambda _{\text {FN}}$. $A$ is an effective coupling given by the product of all couplings in the diagram and another factor taking into account any mass factors between the $\psi _{\text {FN}_i}$ fields}{figure.1}{}}
\newlabel{fig:spag@cref}{{[figure][1][]1}{[1][3][]3}}
