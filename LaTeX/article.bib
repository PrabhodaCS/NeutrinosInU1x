@misc{allali_neutrino_2024,
    title = {Neutrino mass bounds from {DESI} 2024 are relaxed by {Planck} {PR4} and cosmological supernovae},
    url = {http://arxiv.org/abs/2406.14554},
    doi = {10.48550/arXiv.2406.14554},
    abstract = {The recent DESI 2024 Baryon Acoustic Oscillations (BAO) measurements combined with the CMB data from the Planck 18 PR3 dataset and the Planck PR4+ACT DR6 lensing data, with a prior on the sum of the neutrino masses \${\textbackslash}sum m\_ν{\textgreater}0\$, leads to a strong constraint, \${\textbackslash}sum m\_ν{\textless}0.072\$ eV, which would exclude the inverted neutrino hierarchy and put some tension on even the standard hierarchy. We show that actually this bound gets significantly relaxed when combining the new DESI measurements with the HiLLiPoP+LoLLiPoP likelihoods, based on the Planck 2020 PR4 dataset, and with supernovae datasets. We note that the fact that neutrino masses are pushed towards zero, and even towards negative values, is known to be correlated with the so-called \$A\_L\$ tension, a mismatch between lensing and power spectrum measurements in the Planck PR3 data, which is reduced by HiLLiPoP+LoLLiPoP to less than 1\$σ\$. We find \${\textbackslash}sum m\_ν{\textless}0.1\$ eV and \${\textbackslash}sum m\_ν{\textless}0.12\$ eV, with the supernovae Pantheon+ and DES-SN5YR datasets respectively. The shift caused by these datasets is more compatible with the expectations from neutrino oscillation experiments, and both the normal and inverted hierarchy scenarios remain now viable, even with the \${\textbackslash}sum m\_ν{\textgreater}0\$ prior. Finally, we analyze neutrino mass bounds in an extension of \$Λ\$CDM that addresses the \$H\_0\$ tension, with extra fluid Dark Radiation, finding that in such models bounds are further relaxed and the posterior probability for \${\textbackslash}sum m\_ν\$ begins to exhibit a peak at positive values.},
    urldate = {2026-07-17},
    publisher = {arXiv},
    author = {Allali, Itamar J. and Notari, Alessio},
    month = dec,
    year = {2024},
    note = {arXiv:2406.14554 [astro-ph.CO]},
    keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics, High Energy Physics - Phenomenology},
}
@article{collaboration_search_2023,
    title = {Search for the {Majorana} {Nature} of {Neutrinos} in the {Inverted} {Mass} {Ordering} {Region} with {KamLAND}-{Zen}},
    volume = {130},
    issn = {0031-9007, 1079-7114},
    url = {http://arxiv.org/abs/2203.02139},
    doi = {10.1103/PhysRevLett.130.051801},
    abstract = {The KamLAND-Zen experiment has provided stringent constraints on the neutrinoless double-beta (\$0νββ\$) decay half-life in \${\textasciicircum}\{136\}\$Xe using a xenon-loaded liquid scintillator. We report an improved search using an upgraded detector with almost double the amount of xenon and an ultralow radioactivity container, corresponding to an exposure of 970 kg yr of \${\textasciicircum}\{136\}\$Xe. These new data provide valuable insight into backgrounds, especially from cosmic muon spallation of xenon, and have required the use of novel background rejection techniques. We obtain a lower limit for the \$0νββ\$ decay half-life of \$T\_\{1/2\}{\textasciicircum}\{0ν\} {\textgreater} 2.3 {\textbackslash}times 10{\textasciicircum}\{26\}\$ yr at 90\% C.L., corresponding to upper limits on the effective Majorana neutrino mass of 36-156 meV using commonly adopted nuclear matrix element calculations.},
    number = {5},
    urldate = {2026-07-17},
    journal = {Physical Review Letters},
    author = {Collaboration, KamLAND-Zen and Abe, S. and Asami, S. and Eizuka, M. and Futagi, S. and Gando, A. and Gando, Y. and Gima, T. and Goto, A. and Hachiya, T. and Hata, K. and Hayashida, S. and Hosokawa, K. and Ichimura, K. and Ieki, S. and Ikeda, H. and Inoue, K. and Ishidoshiro, K. and Kamei, Y. and Kawada, N. and Kishimoto, Y. and Koga, M. and Kurasawa, M. and Maemura, N. and Mitsui, T. and Miyake, H. and Nakahata, T. and Nakamura, K. and Nakamura, K. and Nakamura, R. and Ozaki, H. and Sakai, T. and Sambonsugi, H. and Shimizu, I. and Shirai, J. and Shiraishi, K. and Suzuki, A. and Suzuki, Y. and Takeuchi, A. and Tamae, K. and Ueshima, K. and Watanabe, H. and Yoshida, Y. and Obara, S. and Ichikawa, A. K. and Chernyak, D. and Kozlov, A. and Nakamura, K. Z. and Yoshida, S. and Takemoto, Y. and Umehara, S. and Fushimi, K. and Kotera, K. and Urano, Y. and Berger, B. E. and Fujikawa, B. K. and Learned, J. G. and Maricic, J. and Axani, S. N. and Smolsky, J. and Fu, Z. and Winslow, L. A. and Efremenko, Y. and Karwowski, H. J. and Markoff, D. M. and Tornow, W. and Dell'Oro, S. and O'Donnell, T. and Detwiler, J. A. and Enomoto, S. and Decowski, M. P. and Grant, C. and Li, A. and Song, H.},
