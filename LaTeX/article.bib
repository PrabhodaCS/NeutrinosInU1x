@article{jeffreys_invariant_1946,
    title = {An invariant form for the prior probability in estimation problems},
    volume = {186},
    issn = {0080-4630},
    url = {https://doi.org/10.1098/rspa.1946.0056},
    doi = {10.1098/rspa.1946.0056},
    abstract = {It is shown that a certain differential form depending on the values of the parameters in a law of chance is invariant for all transformations of the parameters when the law is differentiable with regard to all parameters. For laws containing a location and a scale parameter a form with a somewhat restricted type of invariance is found even when the law is not everywhere differentiable with regard to the parameters. This form has the properties required to give a general rule for stating the prior probability in a large class of estimation problems.},
    number = {1007},
    urldate = {2026-05-05},
    journal = {Proceedings of the Royal Society of London. A. Mathematical and Physical Sciences},
    author = {Jeffreys, Harold},
    month = sep,
    year = {1946},
    pages = {453--461},
}
@article{collaboration_desi_2025,
    title = {{DESI} 2024 {VI}: {Cosmological} {Constraints} from the {Measurements} of {Baryon} {Acoustic} {Oscillations}},
    volume = {2025},
    issn = {1475-7516},
    shorttitle = {{DESI} 2024 {VI}},
    url = {http://arxiv.org/abs/2404.03002},
    doi = {10.1088/1475-7516/2025/02/021},
    abstract = {We present cosmological results from the measurement of baryon acoustic oscillations (BAO) in galaxy, quasar and Lyman-\$α\$ forest tracers from the first year of observations from the Dark Energy Spectroscopic Instrument (DESI), to be released in the DESI Data Release 1. DESI BAO provide robust measurements of the transverse comoving distance and Hubble rate, or their combination, relative to the sound horizon, in seven redshift bins from over 6 million extragalactic objects in the redshift range \$0.1{\textless}z{\textless}4.2\$. DESI BAO data alone are consistent with the standard flat \$Λ\$CDM cosmological model with a matter density \$Ω\_{\textbackslash}mathrm\{m\}=0.295{\textbackslash}pm 0.015\$. Paired with a BBN prior and the robustly measured acoustic angular scale from the CMB, DESI requires \$H\_0=(68.52{\textbackslash}pm0.62)\$ km/s/Mpc. In conjunction with CMB anisotropies from Planck and CMB lensing data from Planck and ACT, we find \$Ω\_{\textbackslash}mathrm\{m\}=0.307{\textbackslash}pm 0.005\$ and \$H\_0=(67.97{\textbackslash}pm0.38)\$ km/s/Mpc. Extending the baseline model with a constant dark energy equation of state parameter \$w\$, DESI BAO alone require \$w=-0.99{\textasciicircum}\{+0.15\}\_\{-0.13\}\$. In models with a time-varying dark energy equation of state parametrized by \$w\_0\$ and \$w\_a\$, combinations of DESI with CMB or with SN{\textasciitilde}Ia individually prefer \$w\_0{\textgreater}-1\$ and \$w\_a{\textless}0\$. This preference is 2.6\$σ\$ for the DESI+CMB combination, and persists or grows when SN{\textasciitilde}Ia are added in, giving results discrepant with the \$Λ\$CDM model at the \$2.5σ\$, \$3.5σ\$ or \$3.9σ\$ levels for the addition of Pantheon+, Union3, or DES-SN5YR datasets respectively. For the flat \$Λ\$CDM model with the sum of neutrino mass \${\textbackslash}sum m\_ν\$ free, combining the DESI and CMB data yields an upper limit \${\textbackslash}sum m\_ν{\textless} 0.072\$ \$(0.113)\$ eV at 95\% confidence for a \${\textbackslash}sum m\_ν{\textgreater}0\$ \$({\textbackslash}sum m\_ν{\textgreater}0.059)\$ eV prior. These neutrino-mass constraints are substantially relaxed in models beyond \$Λ\$CDM. [Abridged.]},
