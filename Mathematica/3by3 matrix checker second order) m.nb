        RowBox[{"s13", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"U", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"th13", "=", 
