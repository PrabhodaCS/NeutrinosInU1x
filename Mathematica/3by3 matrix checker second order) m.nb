               RowBox[{"-", "I"}], " ", "ph"}], "]"}]}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"U", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Map", "[", 
