Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", "numeric"}], " ", "tolerance", " ", "aware", " ", 
     "eigen"}], "-", 
    RowBox[{"decomposition", " ", "that", " ", "returns", " ", "sorted", " ", 
     RowBox[{"eigenpairs", "--"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GetEigenSystem", "[", 
      RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "vecs", ",", "ord", ",", "P"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", "M", "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "vals", " ", "may", " ", "be", " ", "symbolic", " ", "or", " ", 
          "numeric"}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"keep", " ", "order", " ", "positions", " ", 
           RowBox[{"stable", ":", 
            RowBox[{"return", " ", "as", " ", "given"}]}]}], ",", 
          RowBox[{
          "but", " ", "also", " ", "provide", " ", "ordering", " ", "by", " ",
            "value"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"ord", "=", 
         RowBox[{"Ordering", "[", "vals", "]"}]}], ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"P", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ord", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "==", "i"}], ",", "1", ",", 
               "0"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"ascending", " ", "by", " ", "default"}], "*)"}], 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<evals\>\"", "->", "vals"}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<evects\>\"", "->", "vecs"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<ordering\>\"", "->", "ord"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<P\>\"", "->", "P"}]}], "\[IndentingNewLine]", 
         "|>"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", "detect"}], " ", 
     RowBox[{"degeneracies", ":", 
      RowBox[{
      "returns", " ", "list", " ", "of", " ", "index", " ", "lists", " ", 
       "for", " ", "degenerate", " ", 
       RowBox[{"groups", "--"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GetDegenerateGroups", "[", 
      RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "inds"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"vals", "=", 
         RowBox[{"Eigenvalues", "[", "M", "]"}]}], ";", "\n", "\t", 
        RowBox[{"inds", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "vals", "]"}], "]"}]}], ";", " ", 
        RowBox[{"(*", 
         RowBox[{"Creates", " ", "the", " ", "list", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "*)"}], "\n", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Group", " ", "the", " ", "indices", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], " ", "based", " ", "on", 
          " ", "the", " ", "actual", " ", "eigenvalue", " ", "at", " ", 
          "that", " ", "position"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Values", "[", 
         RowBox[{"GroupBy", "[", 
          RowBox[{"inds", ",", 
           RowBox[{
            RowBox[{"vals", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "&"}]}], "]"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"example", ":", 
     RowBox[{"returns", " ", 
      RowBox[{"{", "}"}], " ", "if", " ", "no", " ", "degeneracies", " ", 
      RowBox[{"(", 
       RowBox[{"every", " ", "group", " ", "is", " ", "size", " ", "1"}], 
       ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"IsDegenerateQ", "[", 
      RowBox[{"M_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"AnyTrue", "[", 
      RowBox[{
       RowBox[{"GetDegenerateGroups", "[", "M", "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
