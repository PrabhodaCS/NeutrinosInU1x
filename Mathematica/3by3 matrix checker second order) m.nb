Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DegenCase", "[", 
    RowBox[{"M_", ",", "q_Symbol"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pert", ",", "M0", ",", "M1", ",", "M2", ",", "vals0", ",", "vecs0", ",",
        "n", ",", "groups", ",", "allIdx", ",", "valsSeries", ",", 
       "vecsSeries", ",", "b", ",", "blockIdx", ",", "m", ",", "blockVecs", ",",
        "lambda0block", ",", "W", ",", "wvals", ",", "wvecs", ",", "psi0s", ",",
        "outsideIdx", ",", "lambda1block", ",", "lambda2block", ",", 
       "psiFirstOrderOutside", ",", "psiSecOrderOutside", ",", "H2eff", ",", 
       "H2vals", ",", "H2vecs", ",", "psiFromH2", ",", "k", ",", "nidx", ",", 
       "psi1", ",", "psi2", ",", "project0", ",", "outside"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "function", " ", "to", " ", "enforce", " ", "intermediate", " ", 
       "normalization"}], "*)"}], 
     RowBox[{
      RowBox[{
       RowBox[{"project0", "[", 
        RowBox[{"v_", ",", "idx_"}], "]"}], ":=", 
       RowBox[{"v", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"vecs0", "[", 
             RowBox[{"[", "idx", "]"}], "]"}], "]"}], ".", "v"}], ")"}], " ", 
         RowBox[{"vecs0", "[", 
          RowBox[{"[", "idx", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"1", ")"}], " ", "rescaled", " ", "coefficient", " ", 
        "matrices"}], "*)"}], 
      RowBox[{"pert", "=", 
       RowBox[{"RescaleAndCoefficients", "[", 
        RowBox[{
         RowBox[{"M", "[", "q", "]"}], ",", "q", ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"M0", ",", "M1", ",", "M2"}], "}"}], "=", 
       RowBox[{"pert", "[", "\"\<coefficients\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"2", ")"}], " ", "zeroth"}], "-", 
        RowBox[{"order", " ", "eigendecomposition"}]}], "*)"}], 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals0", ",", "vecs0"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", "M0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "vals0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"groups", "=", 
       RowBox[{"GetDegenerateGroups", "[", "M0", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"allIdx", "=", 
       RowBox[{"Range", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"3", ")"}], " ", "initialize", " ", "result", " ", 
        "containers"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"valsSeries", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vecsSeries", "=", 
