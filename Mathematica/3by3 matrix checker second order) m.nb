        RowBox[{"epsVal", "=", 
         RowBox[{"theta", "[", 
          RowBox[{"[", 
           RowBox[{"epsPos", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
