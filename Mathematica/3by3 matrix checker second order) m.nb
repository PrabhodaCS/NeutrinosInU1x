Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "rescale", " ", "and", " ", "get", " ", "coefficients", " ", "up", " ", 
    "to", " ", "maxOrder"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"RescaleAndCoefficients", "[", 
      RowBox[{"mat_", ",", "q_", ",", 
       RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "pmin", ",", "scaled", ",", "nrows", ",", "ncols", ",", 
         "coeffMatrices"}], "}"}], ",", 
       RowBox[{
        RowBox[{"pmin", "=", 
         RowBox[{"MatrixMinPower", "[", 
          RowBox[{"mat", ",", "q"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"scaled", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{"mat", "/", 
           RowBox[{"q", "^", "pmin"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"nrows", ",", "ncols"}], "}"}], "=", 
         RowBox[{"Dimensions", "[", "scaled", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coeffMatrices", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Expand", "[", 
                RowBox[{"scaled", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], ",", "q", ",",
                "k"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nrows"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "ncols"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "maxOrder"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<minPower\>\"", "->", "pmin"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<rescaledMatrix\>\"", "->", "scaled"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<coefficients\>\"", "->", "coeffMatrices"}]}], 
         "|>"}]}]}], "]"}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.96391970486845*^9, 3.963919721201906*^9}, {
