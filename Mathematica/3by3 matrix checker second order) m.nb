              RowBox[{"2", ",", "3"}], "]"}], "]"}], "]"}], "/", 
           RowBox[{"Abs", "[", 
            RowBox[{"U", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "3"}], "]"}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
