               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Conjugate", "[", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "]"}], ".", 
                   RowBox[{"(", 
                    RowBox[{"M1", ".", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "nidx", "]"}], "]"}]}], ")"}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"vals0", "[", 
                    RowBox[{"[", "nidx", "]"}], "]"}], "-", 
                   RowBox[{"vals0", "[", 
                    RowBox[{"[", "m", "]"}], "]"}]}], ")"}]}], " ", 
                RowBox[{"vecs0", "[", 
                 RowBox[{"[", "m", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"m", ",", "outside"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"psi1", "=", 
             RowBox[{"project0", "[", 
              RowBox[{"psi1", ",", "nidx"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"second", "-", 
              RowBox[{
              "order", " ", "correction", " ", "to", " ", "eigenvector"}]}], 
             "*)"}], 
            RowBox[{"psi2", "=", 
             RowBox[{"Simplify", "@", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"num", ",", "denom"}], "}"}], ",", 
                  RowBox[{
                   RowBox[{"denom", "=", 
                    RowBox[{
                    RowBox[{"vals0", "[", 
                    RowBox[{"[", "nidx", "]"}], "]"}], "-", 
                    RowBox[{"vals0", "[", 
                    RowBox[{"[", "m", "]"}], "]"}]}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"num", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "]"}], ".", 
                    RowBox[{"(", 
                    RowBox[{"M2", ".", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "nidx", "]"}], "]"}]}], ")"}]}], ")"}], "+", 
