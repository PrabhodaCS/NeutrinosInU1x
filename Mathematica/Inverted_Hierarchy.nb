                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "]"}], ".", 
                    RowBox[{"(", 
                    RowBox[{"M1", ".", "psi1"}], ")"}]}], ")"}], "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "nidx", "]"}], "]"}], "]"}], ".", 
                    RowBox[{"(", 
                    RowBox[{"M1", ".", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "nidx", "]"}], "]"}]}], ")"}]}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"vecs0", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], "]"}], ".", "psi1"}], 
                    ")"}]}]}]}], ";", "\[IndentingNewLine]", 
