Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LeadingPowerOfExpr", "[", 
     RowBox[{"expr_", ",", "q_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"terms", ",", "powers", ",", "minPow"}], "}"}], ",", 
      RowBox[{
       RowBox[{"terms", "=", 
        RowBox[{"List", "@@", 
         RowBox[{"Expand", "[", "expr", "]"}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"1", ")"}], " ", "break", " ", "expression", " ", "into", " ",
          "additive", " ", "terms"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"2", ")"}], " ", "find", " ", "exponent", " ", "of", " ", 
         "q", " ", "in", " ", "each", " ", "term", " ", 
         RowBox[{"(", 
          RowBox[{
          "works", " ", "for", " ", "negative", " ", "integer", " ", "powers",
            " ", "too"}], ")"}]}], "*)"}], 
       RowBox[{"powers", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "q"}], "]"}], "&"}], "/@", "terms"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minPow", "=", 
        RowBox[{"Min", "[", "powers", "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"3", ")"}], " ", "the", " ", "smallest", " ", "power", " ", 
         "among", " ", "terms"}], "*)"}], "minPow"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MatrixMinPower", "[", 
    RowBox[{"mat_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nrows", ",", "ncols", ",", "powers"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nrows", ",", "ncols"}], "}"}], "=", 
       RowBox[{"Dimensions", "[", "mat", "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "matrix", " ", "size"}], "*)"}], 
      RowBox[{"powers", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"LeadingPowerOfExpr", "[", 
          RowBox[{
           RowBox[{"mat", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", "q"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nrows"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "ncols"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "matrix", " ", "of", " ", "min", " ", "powers", " ", "per", " ", 
        "element"}], "*)"}], 
      RowBox[{"Min", "@", 
       RowBox[{"Flatten", "[", "powers", "]"}]}]}]}], 
    "                               ", 
    RowBox[{"(*", 
     RowBox[{
     "global", " ", "minimum", " ", "across", " ", "entire", " ", "matrix"}], 
     "*)"}], "]"}]}], ";"}]}], "Input",
